# Stock Portfolio Agent - Environment Variables
# Copy this file to .env and fill in your values

# Run Configuration
RUN_TYPE=morning  # "morning" or "evening"

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FMP_API_KEY=your_financial_modeling_prep_key
FINNHUB_API_KEY=your_finnhub_key
GEMINI_API_KEY=your_gemini_api_key

# Notifications
SENDGRID_API_KEY=your_sendgrid_key
NOTIFICATION_EMAIL_TO=you@example.com
NOTIFICATION_EMAIL_FROM=portfolio-agent@yourdomain.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google Cloud (only needed for cloud deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=portfolio-agent-reports
